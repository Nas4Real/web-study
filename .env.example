# Required for the private-beta deployment. NEXT_PUBLIC_* values are embedded
# in the client bundle and must be configured for each Vercel environment.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_ORIGIN=

# Optional server-only values. Never prefix these with NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY is reserved for future administrative jobs and is not
# required by the current user-scoped application.
SUPABASE_SECRET_KEY=

# R2 is optional for the first private beta. Leave all four values unset; the
# application clearly disables document uploads. Configure all four together
# when the storage integration is enabled later.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Deferred Epic 07 / operational-job secrets. Not required for the two-user beta.
API_KEY_HASH_PEPPER=
CRON_SECRET=
